# =====================================================================
# TechService API - Exemplo de variáveis de ambiente locais
# Copie este arquivo para .env e ajuste as configurações conforme necessário.
# =====================================================================

# Chave secreta do Django (usada apenas para desenvolvimento local)
SECRET_KEY=django-insecure-local-dev-key-change-this-in-production

# Modo de depuração (True para desenvolvimento local, False em produção)
DEBUG=True

# Hosts permitidos (separados por vírgula)
ALLOWED_HOSTS=localhost,127.0.0.1
